# ─── LLM Inference Web — Environment Variables ───────────────────────────────
# Place this file at the ROOT of your project: llm-inference-web/.env
# Never commit this file to Git — it's already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Local Ollama ──────────────────────────────────────────────────────────────
# URL where Ollama is running locally (default is fine if running on same machine)
OLLAMA_URL=http://localhost:11434

# Model names as they appear in your Ollama installation (run: ollama list)
OLLAMA_LLAMA_MODEL=llama3
OLLAMA_MISTRAL_MODEL=mistral

# ── OpenAI (GPT) ──────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-haiku-20240307

# ── OpenWeatherMap (Weather Mode) ─────────────────────────────────────────────
# Free tier is sufficient — get your key at: https://openweathermap.org/api
# After signing up, key activates within ~10 minutes
OPENWEATHER_API_KEY=your-openweathermap-api-key-here
