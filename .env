# ─── LLM Inference Web — Environment Variables ───────────────────────────────
# Place this file at the ROOT of your project: llm-inference-web/.env
# This file must NEVER be committed to Git — add .env to your .gitignore
# VERY IMPORTANT to not commit any actual API key to git, security risk and the key will be invalidated
# ─────────────────────────────────────────────────────────────────────────────

# ── Local Ollama ──────────────────────────────────────────────────────────────
# URL where Ollama is running (default is fine if on the same machine)
OLLAMA_URL=http://localhost:11434
# Run: ollama pull llama3.2:1b   (only ~1.3 GB RAM required)
OLLAMA_LLAMA_MODEL=llama3.2:1b

# ── GPT ──────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
