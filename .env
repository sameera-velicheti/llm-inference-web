# ─── LLM Inference Web — Environment Variables ───────────────────────────────
# Place this file at the ROOT of your project: llm-inference-web/.env
# This file must NEVER be committed to Git — add .env to your .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Local Ollama ──────────────────────────────────────────────────────────────
# URL where Ollama is running (default is fine if on the same machine)
OLLAMA_URL=http://localhost:11434
# Run: ollama pull llama3.2:1b   (only ~1.3 GB RAM required)
OLLAMA_LLAMA_MODEL=llama3.2:1b

# ── OpenAI (GPT) ──────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# NEVER paste a real key into any file that gets committed to Git
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBVGlAbkgTZ9KHNAQ-J08epTSy87SG32Kc
GEMINI_MODEL=gemini-2.5-flash

# ── OpenWeatherMap (Weather Mode) ─────────────────────────────────────────────
# Free tier is sufficient — https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key-here
